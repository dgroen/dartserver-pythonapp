# Extend the official WSO2 Identity Server image to include PostgreSQL JDBC driver
FROM wso2/wso2is:7.1.0

# Switch to root to install packages
USER root

# Install wget to download the PostgreSQL driver
RUN apt-get update && \
    apt-get install -y --no-install-recommends wget && \
    rm -rf /var/lib/apt/lists/*

# Download PostgreSQL JDBC driver and place in multiple WSO2 lib locations
RUN WSO2_HOME=/home/wso2carbon/wso2is-7.1.0 && \
    echo "Downloading PostgreSQL JDBC driver..." && \
    wget --no-verbose https://jdbc.postgresql.org/download/postgresql-42.7.2.jar \
      -O /tmp/postgresql-42.7.2.jar && \
    echo "✅ Download successful" && \
    \
    echo "Installing driver to repository/components/lib..." && \
    mkdir -p $WSO2_HOME/repository/components/lib && \
    cp /tmp/postgresql-42.7.2.jar $WSO2_HOME/repository/components/lib/ && \
    chmod 644 $WSO2_HOME/repository/components/lib/postgresql-42.7.2.jar && \
    \
    echo "Installing driver to lib..." && \
    mkdir -p $WSO2_HOME/lib && \
    cp /tmp/postgresql-42.7.2.jar $WSO2_HOME/lib/ && \
    chmod 644 $WSO2_HOME/lib/postgresql-42.7.2.jar && \
    \
    echo "Verifying installations:" && \
    ls -lh $WSO2_HOME/repository/components/lib/postgresql-42.7.2.jar && \
    ls -lh $WSO2_HOME/lib/postgresql-42.7.2.jar && \
    rm /tmp/postgresql-42.7.2.jar && \
    echo "✅ PostgreSQL driver installed successfully in both locations"
