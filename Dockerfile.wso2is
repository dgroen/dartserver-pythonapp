# Extend the official WSO2 Identity Server image to include PostgreSQL JDBC driver
FROM wso2/wso2is:7.1.0

# Switch to root to install packages
USER root

# Install wget to download the PostgreSQL driver
RUN apt-get update && \
    apt-get install -y --no-install-recommends wget && \
    rm -rf /var/lib/apt/lists/*

# Download and install PostgreSQL JDBC driver (postgresql-42.7.2.jar)
# Place it in the WSO2IS lib directory so it's available on the classpath
RUN mkdir -p /home/wso2carbon/wso2is-7.1.0/lib && \
    wget -q https://jdbc.postgresql.org/download/postgresql-42.7.2.jar \
    -O /home/wso2carbon/wso2is-7.1.0/lib/postgresql-42.7.2.jar && \
    chmod 644 /home/wso2carbon/wso2is-7.1.0/lib/postgresql-42.7.2.jar

# Verify the driver was installed
RUN ls -lh /home/wso2carbon/wso2is-7.1.0/lib/postgresql*.jar || echo "WARNING: PostgreSQL driver not found"

# Switch back to wso2carbon user
USER wso2carbon

# Use the default entrypoint from the base image
ENTRYPOINT ["/home/wso2carbon/docker-entrypoint.sh"]
