# Test Environment Configuration
# Use this configuration for running automated tests
# Access at: https://localhost:5000 (test environment)
# Note: This configuration uses a dedicated test database and test WSO2 settings

ENVIRONMENT=test
APP_DOMAIN=test.letsplaydarts.eu
APP_SCHEME=https
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
FLASK_USE_SSL=True
SECRET_KEY=test-secret-key-for-automated-testing  # pragma: allowlist secret

# Session Configuration for HTTPS with self-signed certificates
# Set to False for localhost HTTPS to prevent cookie issues with self-signed certificates
# SameSite=Lax provides sufficient security for test environment
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# RabbitMQ Configuration (Test)
# Use local RabbitMQ instance for testing
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest  # pragma: allowlist secret
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=darts_exchange_test
RABBITMQ_TOPIC=darts.scores.#

# Database Configuration (Test)
# Uses dedicated test database to avoid conflicts with development data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dartsdbtest  # pragma: allowlist secret

# Dartboard Configuration
DARTBOARD_SENDS_ACTUAL_SCORE=True

# Text-to-Speech Configuration
# Disable TTS in tests to avoid timing issues and external dependencies
TTS_ENABLED=false
TTS_ENGINE=gtts
TTS_SPEED=150
TTS_VOLUME=0.0
TTS_VOICE=default

# WSO2 Identity Server Configuration (Test)
# Use local WSO2 instance with test credentials

WSO2_IS_URL=https://test.letsplaydarts.eu/auth
# Internal URL for server-to-server communication (Docker network)
WSO2_IS_INTERNAL_URL=https://wso2is:9443
WSO2_CLIENT_ID=z9tDR_MVfS_rHKBlqZ_6Re_TaJga
WSO2_CLIENT_SECRET=lQCbqtHliRy3j_POcCRxm9j7Cj7VqTx6ehRXnNaesUca  # pragma: allowlist secret
WSO2_IS_VERIFY_SSL=False
JWT_VALIDATION_MODE=introspection
WSO2_IS_INTROSPECT_USER=admin
WSO2_IS_INTROSPECT_PASSWORD=admin  # pragma: allowlist secret
WSO2_REDIRECT_URI=https://test.letsplaydarts.eu/callback
WSO2_POST_LOGOUT_REDIRECT_URI=https://test.letsplaydarts.eu/

# Session & Security (HTTPS/Production)
SESSION_COOKIE_SECURE=True

# Authentication
AUTH_DISABLED=False

# Swagger API Documentation
SWAGGER_HOST=test.letsplaydarts.eu
