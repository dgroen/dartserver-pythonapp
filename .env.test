# Dummy test environment file used by automated tests.
# Environment
ENVIRONMENT=test

# Database (use SQLite for tests by default)
DATABASE_URL=sqlite:///test.db

# App configuration
APP_SCHEME=https
FLASK_USE_SSL=True
FLASK_DEBUG=True
SESSION_COOKIE_SECURE=False
APP_DOMAIN=test.letsplaydarts.eu

# RabbitMQ (test exchange)
RABBITMQ_EXCHANGE=darts.test

# Text-to-speech
TTS_ENABLED=false

# WSO2 / OAuth
WSO2_CLIENT_ID=test-client
WSO2_IS_VERIFY_SSL=False
WSO2_IS_URL=https://test.letsplaydarts.eu

# Auth
AUTH_DISABLED=false

# Secret
SECRET_KEY=test-secret
